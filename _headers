# Cloudflare Pages cache rules
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Files that change in place (stable filenames) must always be revalidated,
# so a redeploy is picked up immediately. ETag -> cheap 304 when unchanged.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/custom-theme.css
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Vendored / versioned assets never change -> cache for a year.
/bootstrap-italia/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
